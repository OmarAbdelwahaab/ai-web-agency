# ---------- General ----------
AGENCY_NAME=Your Agency Name
AGENCY_CALLBACK_NUMBER=+1XXXXXXXXXX
AGENT_PERSONA_NAME=Ava
DB_PATH=data/agency.db

# ---------- Safety switches (keep OFF until docs/COMPLIANCE.md is fully checked) ----------
LIVE_DIALING_ENABLED=false
LEGAL_REVIEW_DONE=false
RECORD_CALLS=false
MAX_ATTEMPTS_PER_LEAD=2
CALL_WINDOW_START=08:00
CALL_WINDOW_END=21:00

# ---------- Lead sources ----------
GOOGLE_PLACES_API_KEY=
OVERPASS_URL=https://overpass-api.de/api/interpreter
SEARCH_API_KEY=
SEARCH_ENGINE_ID=

# ---------- LLM (any OpenAI-compatible endpoint; Groq free tier works) ----------
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile

# ---------- LiveKit ----------
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=agency-caller
SIP_OUTBOUND_TRUNK_ID=

# ---------- Voice providers (pick what has a free tier for you) ----------
STT_PROVIDER=deepgram
TTS_PROVIDER=cartesia
VOICE_LLM_PROVIDER=groq
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
GROQ_API_KEY=

# ---------- Telegram (you are the only allowed chat) ----------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------- Payments ----------
PAYMENT_PROVIDER=manual

# ---------- Site deploy (Cloudflare Pages via wrangler) ----------
DEPLOY_ENABLED=false
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# ---------- Site QA (optional; needs Node 22+ and Chrome/Chromium) ----------
# When true, each generated site gets a design-detector run and a mobile screenshot sent to Telegram.
QA_ENABLED=false

# ---------- Optional: email the finished site to the client ----------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
